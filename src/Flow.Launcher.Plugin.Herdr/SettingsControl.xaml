<UserControl x:Class="Flow.Launcher.Plugin.Herdr.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="500">
    <StackPanel Margin="16">
        <TextBlock Text="Herdr executable path"
                   FontWeight="Bold"
                   Margin="0,0,0,4" />
        <TextBlock Text="Command or full path used to invoke herdr, e.g. herdr or C:\tools\herdr.exe. Defaults to 'herdr' resolved via PATH."
                   TextWrapping="Wrap"
                   Opacity="0.7"
                   Margin="0,0,0,8" />
        <TextBox x:Name="HerdrPathTextBox"
                 Width="420"
                 HorizontalAlignment="Left"
                 LostFocus="HerdrPathTextBox_LostFocus" />
    </StackPanel>
</UserControl>
